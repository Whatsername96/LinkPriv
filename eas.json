{
	"cli": {
		"version": ">= 15.0.2",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"autoIncrement": true,
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"autoIncrement": true,
			"distribution": "internal"
		},
		"production": {
			"autoIncrement": true,
			"env": {
				"EXPO_PUBLIC_API_URL": "<EXPO_PUBLIC_API_URL_ENV>",
				"EXPO_PUBLIC_SITE_KEY_RECAPTCHA": "<EXPO_PUBLIC_SITE_KEY_RECAPTCHA_ENV>",
				"EXPO_PUBLIC_ONE_SIGNAL_KEY": "<EXPO_PUBLIC_ONE_SIGNAL_KEY_ENV>"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"appleId": "<EMAIL_LOGIN_APPLE>",
				"ascAppId": "<APP_ID>",
				"appleTeamId": "<TEAM_ID>"
			}
		}
	}
}
