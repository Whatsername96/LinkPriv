{
	"cli": {
		"version": ">= 15.0.2",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"autoIncrement": true,
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"autoIncrement": true,
			"distribution": "internal"
		},
		"production": {
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {
			"android": {
				"serviceAccountKeyPath": "./service-account-file.json",
				"track": "production"
			}
		}
	}
}
